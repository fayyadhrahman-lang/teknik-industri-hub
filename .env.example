# Environment configuration for S1 Teknik Industri Telkom University Hub
# Salin file ini menjadi .env (cp .env.example .env)

# GEMINI_API_KEY: Opsional untuk fitur Asisten Akademik AI (Chatbot).
# Jika dikosongkan, chatbot akan berjalan dalam mode offline cerdas yang tetap menjawab pertanyaan umum kurikulum.
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=

# Port server Express (Default: 3000)
PORT=3000

# Node Environment ('development' atau 'production')
NODE_ENV=production

